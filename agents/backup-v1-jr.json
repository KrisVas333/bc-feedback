  "agent": {
   "first_message": "Labas! Čia BrAIn Club Jr (Info Gynėjai) AI asistentas — dirbtinis intelektas, ne žmogus. Pokalbis įrašomas grįžtamajam ryšiui, garsas nesaugomas, užtruksim iki trijų minučių. Kelinta šiandien buvo pamoka ir kokia data?",
   "language": "lt",
